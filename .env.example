# Copy to .env.local and fill in your Supabase project values.
# Find these at: Supabase dashboard -> Project Settings -> API
# NEVER commit .env.local. NEVER use the sb_secret_* / service_role key in the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
