rules_version = '2';

// Firebase Storage Rules for StayOn Phase 3
// Enforces RLS: users can only access their own files
// Free tier: 50MB max; Premium tier: unlimited
// All files stored under /users/{userId}/attachments/

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to access their own files only
    match /users/{userId}/attachments/{allPaths=**} {
      // Check if user is authenticated and owns the file path
      allow read, write: if request.auth.uid == userId;

      // Metadata validation
      allow write: if request.resource.size < 10 * 1024 * 1024; // Max 10 MB per file
      allow write: if request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Private files—deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
